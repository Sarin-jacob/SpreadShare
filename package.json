{
  "name": "spreadshare",
  "version": "0.1.0",
  "description": "A Serverless, Local-First, Zero-Cost Expense Splitting PWA Powered by Google Workspace",
  "keywords": [
    "split",
    "expense",
    "google",
    "spreadsheet_db"
  ],
  "license": "MIT",
  "author": "Sarin C Jacob",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "predeploy": "npm run check && npm test && npm run build",
    "deploy": "gh-pages -d dist --nojekyll -m \"Deploy to GitHub Pages\""
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.2",
    "gh-pages": "^6.3.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  }
}
